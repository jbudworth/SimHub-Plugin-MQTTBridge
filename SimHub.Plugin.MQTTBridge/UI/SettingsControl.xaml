<UserControl x:Class="SimHub.Plugin.MQTTBridge.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MQTT Bridge" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <styles:SHButtonSecondary x:Name="ExportButton" Height="28" Width="80" VerticalAlignment="Center" Margin="0,0,8,0" Click="ExportButton_Click">Export</styles:SHButtonSecondary>
                    <styles:SHButtonSecondary x:Name="ImportButton" Height="28" Width="80" VerticalAlignment="Center" Margin="0,0,8,0" Click="ImportButton_Click">Import</styles:SHButtonSecondary>
                    <styles:SHButtonPrimary x:Name="SaveButton" Height="28" Width="110" VerticalAlignment="Center" Click="SaveButton_Click">Save settings</styles:SHButtonPrimary>
                </StackPanel>
            </Grid>
            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"
                       Text="Connects independently to an MQTT broker. Uses its own client ID and property prefix, so it can run alongside the SHWotever MQTT Publisher plugin without conflicting."/>

            <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                <styles:SHSection Title="Connection" ShowSeparator="True">
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Host" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1" Margin="0,2,10,2"/>

                        <TextBlock Text="Port" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                        <TextBox x:Name="PortBox" Grid.Row="0" Grid.Column="3" Margin="0,2"/>

                        <TextBlock Text="Username" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="UsernameBox" Grid.Row="1" Grid.Column="1" Margin="0,2,10,2"/>

                        <TextBlock Text="Password" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="3" Margin="0,2"/>

                        <TextBlock Text="Client ID" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="ClientIdBox" Grid.Row="2" Grid.Column="1" Margin="0,2,10,2"/>

                        <TextBlock Text="Property prefix" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                        <TextBox x:Name="PropertyPrefixBox" Grid.Row="2" Grid.Column="3" Margin="0,2"/>

                        <TextBlock Text="Keep-alive (s)" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="KeepAliveBox" Grid.Row="3" Grid.Column="1" Margin="0,2,10,2"/>

                        <CheckBox x:Name="UseTlsCheck" Content="Use TLS" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0">
                            <CheckBox x:Name="AutoConnectCheck" Content="Auto-connect on startup" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <styles:SHButtonSecondary x:Name="ConnectButton" Height="28" Width="90" VerticalAlignment="Center" Margin="0,0,8,0" Click="ConnectButton_Click">Connect</styles:SHButtonSecondary>
                            <styles:SHButtonSecondary x:Name="DisconnectButton" Height="28" Width="90" VerticalAlignment="Center" Margin="0,0,8,0" Click="DisconnectButton_Click">Disconnect</styles:SHButtonSecondary>
                            <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </styles:SHSection>
            </Border>

            <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                <styles:SHSection Title="Publish: SimHub property -&gt; MQTT topic" ShowSeparator="True">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"
                                   Text="Source property must be the full SimHub property name (e.g. DataCorePlugin.GameData.SpeedKmh)."/>
                        <DataGrid x:Name="PublishGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto"
                                  ItemsSource="{Binding PublishMappings}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40"/>
                                <DataGridTextColumn Header="Source property" Binding="{Binding SourceProperty}" Width="260"/>
                                <DataGridTextColumn Header="MQTT topic" Binding="{Binding Topic}" Width="180"/>
                                <DataGridTextColumn Header="QoS (0-2)" Binding="{Binding Qos}" Width="70"/>
                                <DataGridCheckBoxColumn Header="Retain" Binding="{Binding Retain}" Width="55"/>
                                <DataGridTextColumn Header="Min interval (ms)" Binding="{Binding MinIntervalMs}" Width="100"/>
                                <DataGridCheckBoxColumn Header="Only on change" Binding="{Binding OnlyOnChange}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <styles:SHButtonSecondary Height="28" Width="90" VerticalAlignment="Center" Margin="0,0,8,0" Click="AddPublishRow_Click">Add row</styles:SHButtonSecondary>
                            <styles:SHButtonSecondary Height="28" Width="120" VerticalAlignment="Center" Click="RemovePublishRow_Click">Remove selected</styles:SHButtonSecondary>
                        </StackPanel>
                    </StackPanel>
                </styles:SHSection>
            </Border>

            <Border BorderBrush="{DynamicResource AccentColorBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                <styles:SHSection Title="Subscribe: MQTT topic -&gt; SimHub property" ShowSeparator="True">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"
                                   Text="Property name is relative to the prefix above, e.g. 'PitLimiter' becomes 'MqttBridge.PitLimiter'."/>
                        <DataGrid x:Name="SubscribeGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto"
                                  ItemsSource="{Binding SubscribeMappings}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40"/>
                                <DataGridTextColumn Header="MQTT topic" Binding="{Binding Topic}" Width="200"/>
                                <DataGridTextColumn Header="QoS (0-2)" Binding="{Binding Qos}" Width="70"/>
                                <DataGridTextColumn Header="Property name" Binding="{Binding PropertyName}" Width="220"/>
                                <DataGridTextColumn Header="Data type" Binding="{Binding DataType}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <styles:SHButtonSecondary Height="28" Width="90" VerticalAlignment="Center" Margin="0,0,8,0" Click="AddSubscribeRow_Click">Add row</styles:SHButtonSecondary>
                            <styles:SHButtonSecondary Height="28" Width="120" VerticalAlignment="Center" Margin="0,0,8,0" Click="RemoveSubscribeRow_Click">Remove selected</styles:SHButtonSecondary>
                            <styles:SHButtonSecondary Height="28" Width="140" VerticalAlignment="Center" Click="ApplySubscriptions_Click">Apply subscriptions</styles:SHButtonSecondary>
                        </StackPanel>
                    </StackPanel>
                </styles:SHSection>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
